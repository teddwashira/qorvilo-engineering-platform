    {
      "id": "V1005",
      "rule": "category_spike_borderline",
      "transactions": [
        {"id": "C1", "date": "2026-01-05", "description": "Food", "amount": 1000, "category": "Food", "type": "expense"},
        {"id": "C2", "date": "2026-02-05", "description": "Food", "amount": 1000, "category": "Food", "type": "expense"},
