        {"id": "N4", "date": "2026-04-08", "description": "Electricity", "amount": 1800, "category": "Bills", "type": "expense"},
        {"id": "N5", "date": "2026-04-12", "description": "Lunch", "amount": 600, "category": "Food", "type": "expense"}
