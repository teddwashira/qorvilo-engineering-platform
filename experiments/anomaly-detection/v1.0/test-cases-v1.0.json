        {"id": "D1", "date": "2026-04-10", "description": "Supermarket groceries", "amount": 2500, "category": "Food", "type": "expense"},
        {"id": "D2", "date": "2026-04-10", "description": "Supermarket groceries", "amount": 2500, "category": "Food", "type": "expense"}
