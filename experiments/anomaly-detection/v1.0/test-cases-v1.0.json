        {"id": "S3", "date": "2026-03-05", "description": "Transport", "amount": 1000, "category": "Transport", "type": "expense"},
        {"id": "S4", "date": "2026-04-05", "description": "Transport trip 1", "amount": 1000, "category": "Transport", "type": "expense"},
{"id": "S5", "date": "2026-04-10", "description": "Transport trip 2", "amount": 1000, "category": "Transport", "type": "expense"},
{"id": "S6", "date": "2026-04-15", "description": "Transport trip 3", "amount": 1000, "category": "Transport", "type": "expense"}
      ],
      "expected_anomaly_ids": ["spike-Transport-2026-04"]
