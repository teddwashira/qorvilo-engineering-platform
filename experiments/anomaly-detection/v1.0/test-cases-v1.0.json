{
  "project": "QORVILO",
  "experiment": "Anomaly Detection v1.0 - Detection Quality",
  "dataset_type": "synthetic",
  "currency": "KES",
  "scenarios": [
    {
      "id": "V1001",
      "rule": "large_expense_positive",
      "transactions": [
        {"id": "L1", "date": "2026-01-05", "description": "Shopping", "amount": 1000, "category": "Shopping", "type": "expense"},
        {"id": "L2", "date": "2026-01-10", "description": "Shopping", "amount": 1000, "category": "Shopping", "type": "expense"},
        {"id": "L3", "date": "2026-01-15", "description": "Shopping", "amount": 1000, "category": "Shopping", "type": "expense"},
        {"id": "L4", "date": "2026-04-05", "description": "Large shopping purchase", "amount": 6000, "category": "Shopping", "type": "expense"}
      ],
      "expected_anomaly_ids": ["large-L4"]
    },
    {
      "id": "V1002",
      "rule": "large_expense_below_threshold",
      "transactions": [
        {"id": "B1", "date": "2026-01-05", "description": "Shopping", "amount": 1000, "category": "Shopping", "type": "expense"},
        {"id": "B2", "date": "2026-01-10", "description": "Shopping", "amount": 1000, "category": "Shopping", "type": "expense"},
        {"id": "B3", "date": "2026-01-15", "description": "Shopping", "amount": 1000, "category": "Shopping", "type": "expense"},
        {"id": "B4", "date": "2026-04-05", "description": "Normal shopping", "amount": 2499, "category": "Shopping", "type": "expense"}
      ],
      "expected_anomaly_ids": []
    },
    {
      "id": "V1003",
      "rule": "large_expense_higher_baseline",
      "transactions": [
        {"id": "H1", "date": "2026-01-05", "description": "Electronics", "amount": 2000, "category": "Electronics", "type": "expense"},
        {"id": "H2", "date": "2026-01-10", "description": "Electronics", "amount": 2000, "category": "Electronics", "type": "expense"},
        {"id": "H3", "date": "2026-01-15", "description": "Electronics", "amount": 2000, "category": "Electronics", "type": "expense"},
        {"id": "H4", "date": "2026-04-05", "description": "Electronics purchase", "amount": 4900, "category": "Electronics", "type": "expense"}
      ],
      "expected_anomaly_ids": []
    },
    {
      "id": "V1004",
      "rule": "category_spike_positive",
