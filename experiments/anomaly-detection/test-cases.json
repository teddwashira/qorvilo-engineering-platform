  "scenarios": [
    {
      "id": "SC001",
      "rule": "large_expense",
      "transactions": [
        {"id": "L1", "date": "2026-10-01", "description": "Shopping 1", "amount": 1000, "category": "Shopping", "type": "expense"},
        {"id": "L2", "date": "2026-10-05", "description": "Shopping 2", "amount": 1000, "category": "Shopping", "type": "expense"},
        {"id": "L3", "date": "2026-10-10", "description": "Shopping 3", "amount": 1000, "category": "Shopping", "type": "expense"},
