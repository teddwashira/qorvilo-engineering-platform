        {"id": "S4", "date": "2026-10-01", "description": "October shopping", "amount": 6000, "category": "Shopping", "type": "expense"}
      ],
      "expected_anomaly_ids": [
  "large-S4",
  "spike-Shopping-2026-10"
]
